{
  "name": "sam-live",
  "productName": "SAM Live",
  "version": "0.1.0",
  "description": "SAM Live - Accops sales-call copilot for Windows",
  "author": "Accops",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "stub": "node scripts/stub-server.mjs",
    "icon": "node scripts/make-icon.mjs",
    "check": "node test/audio-core.check.mjs && node test/uploader.check.mjs && node test/watcher.check.mjs",
    "test:ui": "node test/ui.check.mjs",
    "test:loopback": "node test/loopback.check.mjs",
    "test:notify": "node test/notify.check.mjs",
    "dist": "npm run icon && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.accops.samlive",
    "productName": "SAM Live",
    "files": [
      "main.js",
      "preload.cjs",
      "lib/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SAM Live",
      "artifactName": "SAM-Live-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.0"
  }
}
